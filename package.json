{
  "name": "pocus-logbook",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "check": "npm run test && npm run build",
    "optimize:forms": "svgo --multipass --folder public/templates --config svgo.config.mjs",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "licenses:notices": "node scripts/generate-third-party-notices.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "svgo": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^5.0.5"
  }
